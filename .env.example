# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medibridge_lab
DB_USER=root
DB_PASSWORD=secret

# Redis (Caching + Geo + PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (Event Bus)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Cloudinary (Report Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security (JWT)
# If using shared secret (Symmetric)
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_bytes_long
# If using RSA keys (Asymmetric)
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# Eureka (Discovery)
EUREKA_URL=http://localhost:8761/eureka/

# Zipkin (Tracing)
ZIPKIN_BASE_URL=http://localhost:9411

# Application
SERVER_PORT=8085
LOG_LEVEL=INFO
